    {
      "name": "Save settings",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Commits settings and shows adjacent feedback.",
      "html": "<button class=\"ds-save\">Save settings</button>",
      "css": ".ds-save{font:14px 'Pet Sans',sans-serif;border:1px solid var(--border,#49434f);border-radius:4px;padding:9px 14px;cursor:pointer;transition:background-color 120ms ease;background:var(--accent,#bb86fc);color:#19121f;border-color:var(--accent,#bb86fc);font-weight:600}.ds-save:hover{background:#cba3ff}.ds-save:disabled{opacity:.6;cursor:wait}.ds-save:focus-visible{outline:2px solid var(--accent,#bb86fc);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-save{transition:none}}"
    },
    {
      "name": "Browse",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Opens the native folder picker.",
      "html": "<button class=\"ds-browse\">Browse…</button>",
      "css": ".ds-browse{font:14px 'Pet Sans',sans-serif;border:1px solid var(--border,#49434f);border-radius:4px;padding:9px 14px;cursor:pointer;transition:background-color 120ms ease;background:#27232c;color:#e1e1e1}.ds-browse:hover{background:#39333e}.ds-browse:focus-visible{outline:2px solid var(--accent,#bb86fc);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-browse{transition:none}}"
    },
    {
      "name": "Quit",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Small footer action.",
      "html": "<button class=\"ds-quit\">Quit T3 Pet</button>",
      "css": ".ds-quit{font:12px 'Pet Sans',sans-serif;background:transparent;color:var(--muted,#b3adb9);border:0;padding:6px 0;cursor:pointer}.ds-quit:hover{color:#e1e1e1;text-decoration:underline;text-underline-offset:3px}.ds-quit:focus-visible{outline:2px solid var(--accent,#bb86fc);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-quit{transition:none}}"
    },
    {
      "name": "Data folder",
      "kind": "input",
      "refersTo": "field",
