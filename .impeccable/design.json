      "html": "<label class=\"ds-folder-label\" for=\"ds-folder\">T3 Code data folder</label><input class=\"ds-folder\" id=\"ds-folder\" value=\"C:\\Users\\Carter\\.t3\\userdata\" spellcheck=\"false\">",
      "css": ".ds-folder-label{display:block;font:500 14px 'Pet Sans',sans-serif;color:#e1e1e1;margin-bottom:8px}.ds-folder{font:14px 'Pet Sans',sans-serif;background:#1e1e1e;color:#e1e1e1;border:1px solid var(--border,#49434f);border-radius:4px;padding:9px 10px;height:40px;caret-color:var(--accent,#bb86fc)}.ds-folder:hover{border-color:#77707f}.ds-folder:focus-visible{outline:2px solid var(--accent,#bb86fc);outline-offset:2px}@media(prefers-reduced-motion:reduce){.ds-folder{transition:none}}"
